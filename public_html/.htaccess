# public_html/.htaccess

# Evitar listado de directorios y definir inicio.php como página principal por defecto
Options -Indexes
DirectoryIndex inicio.php index.php

# Configuración de URLs Amigables y HTTPS
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Descomentar para forzar HTTPS en Hostinger cuando SSL esté instalado:
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Reescritura para sitemap.xml y feed-google.xml
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
    RewriteRule ^feed-google\.xml$ feed-google.php [L]

    # Reescritura de URL amigable para producto: /producto/slug-ejemplo -> producto.php?slug=slug-ejemplo
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^producto/(.+)$ producto.php?slug=$1 [L,QSA]
</IfModule>

# Bloquear acceso directo a archivos sensibles
<FilesMatch "\.(env|sql|log|md)$">
    Require all denied
</FilesMatch>

# Página de error 404 personalizada
ErrorDocument 404 /404.php
